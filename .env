# Shared by `npm run dev` and `npm run build`. Values are public: they are
# inlined into the client bundle, so never put secrets here.
# Override locally in `.env.local`, or per deploy in the hosting provider's env.

# Base URL for API requests.
VITE_API_BASE_URL=/api

# Serve API responses from MSW instead of a real backend.
# Enabled for every build until a real API exists (see README).
VITE_ENABLE_MOCKS=true

# Mock server behaviour (only used when mocks are enabled).
# Each can also be overridden per page load via the URL, e.g.
# ?mockErrorRate=0.5&mockLatencyMinMs=1000&mockLatencyMaxMs=3000
VITE_MOCK_ERROR_RATE=0.2
VITE_MOCK_LATENCY_MIN_MS=300
VITE_MOCK_LATENCY_MAX_MS=800
