# Copy to `.env` for local/dev builds.
# Values prefixed with VITE_ are public: they are inlined into the client bundle,
# so never put secrets here. Override locally in `.env.local`, or per deploy in
# the hosting provider's env.

# Public site origin (no trailing slash). Used for sitemap / robots Sitemap URL.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
VITE_SITE_URL=https://www.giorgos11.site

# Base URL for API requests.
VITE_API_BASE_URL=/api

# Serve API responses from MSW instead of a real backend.
# Defaults to on when unset (until a real API exists). Set to false to opt out.
VITE_ENABLE_MOCKS=true

# Mock server behaviour (only used when mocks are enabled).
# Each can also be overridden per page load via the URL, e.g.
# ?mockErrorRate=0.5&mockLatencyMinMs=1000&mockLatencyMaxMs=3000
VITE_MOCK_ERROR_RATE=0.2
VITE_MOCK_LATENCY_MIN_MS=300
VITE_MOCK_LATENCY_MAX_MS=800
